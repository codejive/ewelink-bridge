EWELINK_ACCOUNT=your-ewelink-email@example.com
EWELINK_PASSWORD=your-ewelink-password
EWELINK_REGION=eu
EWELINK_AREA_CODE=+1
EWELINK_APP_ID=your-ewelink-app-id
EWELINK_APP_SECRET=your-ewelink-app-secret

# Single output: set exactly one of MQTT_URL or NATS_SERVERS.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=
MQTT_PASS=
# NATS_SERVERS=nats://127.0.0.1:4222
# NATS_USER=
# NATS_PASS=
# NATS_TOKEN=
# NATS_CREDS=
# NATS_NAME=ewelink-bridge
# NATS_TLS=false
# NATS_TLS_CA=
# NATS_TLS_CERT=
# NATS_TLS_KEY=

TOPIC_PREFIX=ewelink
SUBJECT_PREFIX=ewelink
MQTT_RETAIN=true
MQTT_QOS=1
MQTT_BUFFER_LIMIT=100000
NATS_BUFFER_LIMIT=100000
NATS_CONNECT_TIMEOUT=10000
NATS_RECONNECT_TIME_WAIT=3000
NATS_MAX_RECONNECT_ATTEMPTS=-1
VERBOSE=false
EXIT_ON_WEBSOCKET_CLOSE=true

# Named outputs: unnamed addresses and credentials are ignored.
# BRIDGE_OUTPUTS=home,events
# MQTT_HOME_URL=mqtt://home-broker:1883
# MQTT_HOME_USER=bridge
# MQTT_HOME_PASS=secret
# NATS_EVENTS_SERVERS=nats://events-one:4222,nats://events-two:4222
# NATS_EVENTS_TOKEN=secret
# Optional overrides of shared protocol defaults.
# MQTT_HOME_BUFFER_LIMIT=50000
# MQTT_HOME_TOPIC_PREFIX=ewelink
# NATS_EVENTS_BUFFER_LIMIT=50000
# NATS_EVENTS_SUBJECT_PREFIX=ewelink
