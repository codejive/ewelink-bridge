EWELINK_ACCOUNT=your-ewelink-email@example.com
EWELINK_PASSWORD=your-ewelink-password
EWELINK_REGION=eu
EWELINK_AREA_CODE=+1
EWELINK_APP_ID=your-ewelink-app-id
EWELINK_APP_SECRET=your-ewelink-app-secret

MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=
MQTT_PASS=

TOPIC_PREFIX=ewelink
VERBOSE=false
MQTT_RETAIN=true
MQTT_QOS=1
MQTT_BUFFER_LIMIT=100000
EXIT_ON_WEBSOCKET_CLOSE=true

# Optional named outputs. When enabled, MQTT_URL/USER/PASS above are ignored.
# MQTT_OUTPUTS=home,remote
# MQTT_HOME_URL=mqtt://home-broker:1883
# MQTT_HOME_USER=bridge
# MQTT_HOME_PASS=secret
# MQTT_REMOTE_URL=mqtts://remote-broker:8883
# MQTT_REMOTE_USER=bridge
# MQTT_REMOTE_PASS=secret
# Optional overrides; otherwise shared defaults above apply.
# MQTT_HOME_BUFFER_LIMIT=100000
# MQTT_REMOTE_TOPIC_PREFIX=ewelink
# MQTT_REMOTE_QOS=1
# MQTT_REMOTE_RETAIN=true
